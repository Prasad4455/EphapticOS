  "cards": [
    {
      "dot": "cyan",
      "title": "Network & Cluster Topology",
      "items": [
        "Public ingress terminates TLS 1.3 at Cloud Load Balancer / Ingress Controller",
        "Workloads run inside private Kubernetes cluster subnets without direct public IPs",
        "Stateful data tier is segregated in an isolated private database subnet"
      ]
    },
    {
      "dot": "emerald",
      "title": "Workloads & Stateful Services",
      "items": [
        "Stateless workloads: EphapticOS FastAPI Pods (scalable via HPA), Next.js UI, and FastMCP Pods",
        "Stateful services: PostgreSQL 17 + PGVector for relational ACLs and dense vector indexes",
        "Property Graph: Neo4j 5.26 cluster with APOC plugins for knowledge graph relationships",
        "Storage: ReadWriteMany PersistentVolumeClaim for filesystem and LanceDB/Kuzu local files"
      ]
    },
    {
      "dot": "rose",
      "title": "Ownership & Trust Boundaries",
      "items": [
        "Platform team owns Ingress, Kubernetes cluster infrastructure, and storage PVCs",
        "Application team owns FastAPI API pods, UI frontend, MCP server, and worker pool",
        "Data team owns PostgreSQL and Neo4j database deployments and backups",
        "Security team manages cluster secrets, credentials, and network policies"
      ]
    },
    {
      "dot": "amber",
      "title": "Explicitly Unconfigured / Unknown Areas",
      "items": [
        "Disaster Recovery cross-region replication is not configured in repository manifests",
        "Egress NAT gateway and Cloud WAF are infrastructure-dependent and marked as unmanaged",
        "External LLM SaaS credentials must be provided via external secrets store"
      ]
    }
  ]
}