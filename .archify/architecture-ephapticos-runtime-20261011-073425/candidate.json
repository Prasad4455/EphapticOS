  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Control Plane",
      "items": [
        "Clients connect via Web UI (Next.js), CLI, or Model Context Protocol (FastMCP)",
        "FastAPI Gateway authenticates requests and resolves tenant workspace contexts",
        "Shared Relational Meta Store (SQLite/Postgres) persists users, permissions, and dataset registrations"
      ]
    },
    {
      "dot": "emerald",
      "title": "Primary Data Path: remember Ingestion",
      "items": [
        "POST /remember arrives at API Gateway and dispatches to Memory Router",
        "Dataset Queue enforces per-process concurrency caps via FIFO slot semaphores",
        "Ingestion Pipeline splits documents into semantic chunks and triggers Ephaptify Extractor",
        "Ephaptify queries LLM Provider to extract entities & relationships against DataPoint schemas",
        "Subprocess DB Workers asynchronously commit knowledge graph to Kuzu and vectors to LanceDB"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Multi-Tenancy",
      "items": [
        "Client Ingress: External untrusted client surface (Web UI, CLI, MCP)",
        "Control Plane: Shared across tenants for global identity and RBAC authorization",
        "Tenant Processing: Scoped execution context with per-dataset concurrency control",
        "Isolated Storage: Dedicated database instances per dataset preventing cross-tenant leakage"
      ]
    },
    {
      "dot": "amber",
      "title": "External Service Integrations",
      "items": [
        "LLM Provider API: Frontier models (OpenAI, Claude, Gemini) or local CPU models (GLiNER)",
        "Embedding Provider API: Dense semantic vector embeddings via FastEmbed or OpenAI Embeddings"
      ]
    }
  ]
}