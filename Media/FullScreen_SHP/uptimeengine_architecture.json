  "cards": [
    {
      "dot": "cyan",
      "title": "Core Services & Agent Execution",
      "items": [
        "FastAPI Server & Typer CLI provide ingress endpoints, routing operational requests into the ToolCallingLLM reason-act loop.",
        "Prompt Engine dynamically inspects registered skills and tool catalogs to compile scoped system prompts.",
        "Safeguards & Approvals gate validates tool arguments and enforcement policies prior to any infrastructure execution."
      ]
    },
    {
      "dot": "rose",
      "title": "Databases, Queues & State Boundaries",
      "items": [
        "Platform State DB (Supabase / PostgreSQL DAL) persists conversation states, OAuth tokens, and user feedback asynchronously.",
        "Async Task Queue and OTel Event Stream manage long-running background tasks and buffer telemetry spans out-of-band.",
        "Local Cache and Session History isolate local YAML configs and runtime traces from third-party persistence."
      ]
    },
    {
      "dot": "emerald",
      "title": "External Services & Target Integrations",
      "items": [
        "Multi-provider LLM inference (OpenAI, Anthropic, Bedrock) normalizes provider access through LiteLLM abstractions.",
        "Target Infrastructure (Kubernetes API server, Prometheus metrics) is accessed via scoped least-privilege credentials.",
        "Remote MCP Servers and outbound Incident Destinations (Slack, Jira, PagerDuty) extend operational actions safely."
      ]
    }
  ]
