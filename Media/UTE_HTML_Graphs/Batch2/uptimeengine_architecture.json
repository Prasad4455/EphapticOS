  "cards": [
    {
      "dot": "cyan",
      "title": "Core Runtime & Orchestration",
      "items": [
        "FastAPI server and Typer CLI serve as ingress layers; requests route into ToolCallingLLM, an iterative reason-act engine.",
        "Prompt Engine dynamically inspects registered skills and active toolsets to compose scoped OpenAI-compatible prompts.",
        "Toolset Manager enforces prerequisite checks in parallel, isolating misconfigured integrations so startup remains resilient."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Security",
      "items": [
        "Untrusted Ingress: External alerts and webhooks terminate at the API Server with bearer-token validation.",
        "Private Orchestration Plane: The LLM reason-act loop executes within an isolated boundary with built-in tool approval gates.",
        "Customer Boundary: Target infrastructure access (Kube API, PromQL, Cloud SDKs) uses scoped least-privilege credentials."
      ]
    },
    {
      "dot": "emerald",
      "title": "State, Telemetry & Dependencies",
      "items": [
        "Persistence: Supabase DAL manages platform state, conversation histories, OAuth refresh tokens, and feedback asynchronously.",
        "Telemetry: OpenTelemetry, Sentry, and Braintrust receive spans, exception captures, and LLM token usage stats out-of-band.",
        "Extensibility: Source and destination plugins normalize incident ingestion and outbound Slack / Jira notifications."
      ]
    }
  ]
